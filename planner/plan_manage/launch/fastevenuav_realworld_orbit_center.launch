<launch>
    <arg name="enable_dynamic_obstacle_detection" default="false" />
    <arg name="odom_topic" default="ekf_quat/ekf_odom" />
    <arg name="cloud_topic" default="cloud_registered" />

    <arg name="virtual_ceil" default="3.0"/>
    <arg name="virtual_ground" default="0.5"/>
    <arg name="flight_type" default="2"/>  <!-- 1:MANUAL_TARGET; 2:PRESET_TARGET -->
    <arg name="traj_yaw_dot_max_per_sec" default="2.0"/>
    <arg name="traj_yaw_dot_dot_max_per_sec" default="5.5"/>
    <arg name="traj_spread_commanded_yaw_over_traj" default="false"/>
    <arg name="traj_commanded_yaw_dynamic_threshold" default="0.05"/>
    <arg name="traj_commanded_yaw_init_window_sec" default="0.12"/>
    <arg name="traj_commanded_yaw_reach_ratio" default="0.8"/>

    <arg name="orbit_center_x" default="2.5"/>
    <arg name="orbit_center_y" default="0.0"/>
    <arg name="orbit_altitude" default="1"/>
    <arg name="orbit_radius" default="1.8"/>

    <group if="$(arg enable_dynamic_obstacle_detection)">
        <node pkg="swarm_bridge" name="traj2odom_node" type="traj2odom_node" output="screen">
            <param name="odom_topic" value="$(arg odom_topic)" />
        </node>

        <include file="$(find dynamic_obstacle_detection)/launch/dynamic_obstacle_detection_indoor.launch" >
            <arg name="odom_topic" value="$(arg odom_topic)" />
            <arg name="cloud_topic" value="$(arg cloud_topic)" />
        </include>
    </group>

    <include file="$(find ego_planner)/launch/include/run_in_sim_realworld.xml">
        <arg name="drone_id" value="0"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>
        <arg name="max_vel" value="1.2" />
        <arg name="max_acc" value="24.0" />
        <arg name="max_jer" value="24.0" />
        <arg name="planning_horizon" value="20" />
        <arg name="thresh_replan_time" value="0.5"/>
        <arg name="traj_yaw_dot_max_per_sec" value="$(arg traj_yaw_dot_max_per_sec)"/>
        <arg name="traj_yaw_dot_dot_max_per_sec" value="$(arg traj_yaw_dot_dot_max_per_sec)"/>
        <arg name="traj_spread_commanded_yaw_over_traj" value="$(arg traj_spread_commanded_yaw_over_traj)"/>
        <arg name="traj_commanded_yaw_dynamic_threshold" value="$(arg traj_commanded_yaw_dynamic_threshold)"/>
        <arg name="traj_commanded_yaw_init_window_sec" value="$(arg traj_commanded_yaw_init_window_sec)"/>
        <arg name="traj_commanded_yaw_reach_ratio" value="$(arg traj_commanded_yaw_reach_ratio)"/>
        <arg name="local_update_range_x" value="30.0" />
        <arg name="local_update_range_y" value="30.0" />
        <arg name="local_update_range_z" value="3.0" />
        <arg name="obstacles_inflation" value="0.2" />
        <arg name="flight_type" value="$(arg flight_type)"/>

        <arg name="point_num" value="11"/>
        <arg name="target0_x" value="$(eval float(arg('orbit_center_x')) - float(arg('orbit_radius')))"/>
        <arg name="target0_y" value="$(arg orbit_center_y)"/>
        <arg name="target0_z" value="$(arg orbit_altitude)"/>
        <arg name="target0_yaw" value="0.0"/>

        <arg name="target1_x" value="$(eval float(arg('orbit_center_x')) - 0.8090169944 * float(arg('orbit_radius')))"/>
        <arg name="target1_y" value="$(eval float(arg('orbit_center_y')) - 0.5877852523 * float(arg('orbit_radius')))"/>
        <arg name="target1_z" value="$(arg orbit_altitude)"/>
        <arg name="target1_yaw" value="0.0"/>

        <arg name="target2_x" value="$(eval float(arg('orbit_center_x')) - 0.3090169944 * float(arg('orbit_radius')))"/>
        <arg name="target2_y" value="$(eval float(arg('orbit_center_y')) - 0.9510565163 * float(arg('orbit_radius')))"/>
        <arg name="target2_z" value="$(arg orbit_altitude)"/>
        <arg name="target2_yaw" value="0.0"/>

        <arg name="target3_x" value="$(eval float(arg('orbit_center_x')) + 0.3090169944 * float(arg('orbit_radius')))"/>
        <arg name="target3_y" value="$(eval float(arg('orbit_center_y')) - 0.9510565163 * float(arg('orbit_radius')))"/>
        <arg name="target3_z" value="$(arg orbit_altitude)"/>
        <arg name="target3_yaw" value="0.0"/>

        <arg name="target4_x" value="$(eval float(arg('orbit_center_x')) + 0.8090169944 * float(arg('orbit_radius')))"/>
        <arg name="target4_y" value="$(eval float(arg('orbit_center_y')) - 0.5877852523 * float(arg('orbit_radius')))"/>
        <arg name="target4_z" value="$(arg orbit_altitude)"/>
        <arg name="target4_yaw" value="0.0"/>

        <arg name="target5_x" value="$(eval float(arg('orbit_center_x')) + float(arg('orbit_radius')))"/>
        <arg name="target5_y" value="$(arg orbit_center_y)"/>
        <arg name="target5_z" value="$(arg orbit_altitude)"/>
        <arg name="target5_yaw" value="0.0"/>

        <arg name="target6_x" value="$(eval float(arg('orbit_center_x')) + 0.8090169944 * float(arg('orbit_radius')))"/>
        <arg name="target6_y" value="$(eval float(arg('orbit_center_y')) + 0.5877852523 * float(arg('orbit_radius')))"/>
        <arg name="target6_z" value="$(arg orbit_altitude)"/>
        <arg name="target6_yaw" value="0.0"/>

        <arg name="target7_x" value="$(eval float(arg('orbit_center_x')) + 0.3090169944 * float(arg('orbit_radius')))"/>
        <arg name="target7_y" value="$(eval float(arg('orbit_center_y')) + 0.9510565163 * float(arg('orbit_radius')))"/>
        <arg name="target7_z" value="$(arg orbit_altitude)"/>
        <arg name="target7_yaw" value="0.0"/>

        <arg name="target8_x" value="$(eval float(arg('orbit_center_x')) - 0.3090169944 * float(arg('orbit_radius')))"/>
        <arg name="target8_y" value="$(eval float(arg('orbit_center_y')) + 0.9510565163 * float(arg('orbit_radius')))"/>
        <arg name="target8_z" value="$(arg orbit_altitude)"/>
        <arg name="target8_yaw" value="0.0"/>

        <arg name="target9_x" value="$(eval float(arg('orbit_center_x')) - 0.8090169944 * float(arg('orbit_radius')))"/>
        <arg name="target9_y" value="$(eval float(arg('orbit_center_y')) + 0.5877852523 * float(arg('orbit_radius')))"/>
        <arg name="target9_z" value="$(arg orbit_altitude)"/>
        <arg name="target9_yaw" value="0.0"/>

        <arg name="target10_x" value="$(eval float(arg('orbit_center_x')) - float(arg('orbit_radius')))"/>
        <arg name="target10_y" value="$(arg orbit_center_y)"/>
        <arg name="target10_z" value="$(arg orbit_altitude)"/>
        <arg name="target10_yaw" value="0.0"/>

        <arg name="virtual_ceil" value="$(arg virtual_ceil)"/>
        <arg name="virtual_ground" value="$(arg virtual_ground)"/>
    </include>

    <node pkg="ego_planner" type="orbit_face_center_yaw_node" name="drone_0_orbit_face_center_yaw" output="screen">
        <param name="cmd_topic" value="/drone_0_planning/pos_cmd"/>
        <param name="yaw_cmd_topic" value="/drone_0_ego_planner_node/planning/yaw_cmd"/>
        <param name="use_yaw_cmd_topic" value="/drone_0_ego_planner_node/planning/use_yaw_cmd"/>
        <param name="center_x" value="$(arg orbit_center_x)"/>
        <param name="center_y" value="$(arg orbit_center_y)"/>
        <param name="publish_rate" value="120.0"/>
        <param name="cmd_timeout" value="0.15"/>
        <param name="min_distance" value="0.05"/>
    </node>
</launch>

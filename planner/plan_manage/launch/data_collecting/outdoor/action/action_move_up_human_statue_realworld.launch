	<param name="/drone_0_ego_planner_node/fsm/waypoint32_z" value="0.719"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint32_yaw" value="-0.102"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint32_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint37_z" value="1.326"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_yaw" value="0.118"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_cam_pitch" value="0"/>

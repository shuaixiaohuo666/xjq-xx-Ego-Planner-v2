<launch>
	<arg name="enable_dynamic_obstacle_detection" value="false" />

	<arg name="odom_topic" value="ekf_quat/ekf_odom" />
	<arg name="cloud_topic" value="cloud_registered"/>

	<arg name="virtual_ceil" value="12.0"/>
	<arg name="virtual_ground" value="0.5"/>
	<arg name="flight_type" default="2"/>  <!-- 1:MANUAL_TARGET; 2:PRESET_TARGET -->
	<arg name="traj_yaw_dot_max_per_sec" value="7.0"/>
	<arg name="traj_yaw_dot_dot_max_per_sec" value="14.0"/>
	<arg name="traj_spread_commanded_yaw_over_traj" value="true"/>
	<arg name="traj_commanded_yaw_dynamic_threshold" value="0.05"/>
	<arg name="traj_commanded_yaw_init_window_sec" value="0.12"/>

	<!-- mission behaviour -->
	<arg name="auto_repeat_mission" value="false"/>
	<arg name="waypoint_hold_velocity_thresh" value="0.15"/>
	<arg name="gimbal_pitch_reach_thresh_deg" value="5.0"/>
	<arg name="gimbal_waypoint_reach_thresh_m" value="0.25"/>
	<arg name="gimbal_action_waypoint_indices" value=""/>
	<!-- 10-path chained mission total waypoints -->
	<arg name="point_num" value="40"/>

	<!-- run_in_sim_realworld.xml supports target0..target10 only -->
	<arg name="target0_x" value="3.627"/>
	<arg name="target0_y" value="0.013"/>
	<arg name="target0_z" value="0.658"/>
	<arg name="target0_yaw" value="0.013"/>
	<arg name="target0_cam_pitch" value="0"/>

	<arg name="target1_x" value="3.540"/>
	<arg name="target1_y" value="0.042"/>
	<arg name="target1_z" value="1.358"/>
	<arg name="target1_yaw" value="0.019"/>
	<arg name="target1_cam_pitch" value="0"/>

	<arg name="target2_x" value="3.591"/>
	<arg name="target2_y" value="0.003"/>
	<arg name="target2_z" value="1.891"/>
	<arg name="target2_yaw" value="0.022"/>
	<arg name="target2_cam_pitch" value="0"/>

	<arg name="target3_x" value="3.590"/>
	<arg name="target3_y" value="0.030"/>
	<arg name="target3_z" value="2.577"/>
	<arg name="target3_yaw" value="0.009"/>
	<arg name="target3_cam_pitch" value="0"/>

	<arg name="target4_x" value="3.692"/>
	<arg name="target4_y" value="0.117"/>
	<arg name="target4_z" value="0.572"/>
	<arg name="target4_yaw" value="0.103"/>
	<arg name="target4_cam_pitch" value="0"/>

	<arg name="target5_x" value="3.613"/>
	<arg name="target5_y" value="-0.119"/>
	<arg name="target5_z" value="1.347"/>
	<arg name="target5_yaw" value="-0.007"/>
	<arg name="target5_cam_pitch" value="0"/>

	<arg name="target6_x" value="3.485"/>
	<arg name="target6_y" value="0.018"/>
	<arg name="target6_z" value="1.824"/>
	<arg name="target6_yaw" value="-0.001"/>
	<arg name="target6_cam_pitch" value="0"/>

	<arg name="target7_x" value="3.519"/>

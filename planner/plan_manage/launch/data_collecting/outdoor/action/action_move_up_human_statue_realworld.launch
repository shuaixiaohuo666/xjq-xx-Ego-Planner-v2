	<param name="/drone_0_ego_planner_node/fsm/waypoint29_x" value="3.553"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_y" value="0.089"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_z" value="1.370"/>

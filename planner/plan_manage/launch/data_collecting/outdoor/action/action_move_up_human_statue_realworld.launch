	<param name="/drone_0_ego_planner_node/fsm/waypoint33_z" value="1.334"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_yaw" value="-0.029"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_x" value="3.490"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_y" value="0.197"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_z" value="1.917"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_yaw" value="-0.017"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_x" value="3.771"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="0.028"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="2.480"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="0.005"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_x" value="3.531"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_y" value="-0.125"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="0.616"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="0.061"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint28_y" value="-0.021"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_z" value="0.760"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_yaw" value="0.010"/>

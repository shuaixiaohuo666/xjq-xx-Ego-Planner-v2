	<arg name="target6_x" value="-4.877"/>
	<arg name="target6_y" value="4.079"/>
	<arg name="target6_z" value="0.874"/>
	<arg name="target6_yaw" value="0.033"/>
	<arg name="target6_cam_pitch" value="0"/>


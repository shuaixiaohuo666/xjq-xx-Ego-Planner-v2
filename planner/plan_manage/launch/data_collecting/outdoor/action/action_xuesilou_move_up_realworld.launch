	<arg name="target2_y" value="4.197"/>
	<arg name="target2_z" value="1.603"/>
	<arg name="target2_yaw" value="-0.010"/>
	<arg name="target2_cam_pitch" value="0"/>

	<arg name="target3_x" value="-4.843"/>

<launch>
	<arg name="enable_dynamic_obstacle_detection" value="false" />

	<arg name="odom_topic" value="ekf_quat/ekf_odom" />
	<arg name="cloud_topic" value="cloud_registered"/>

	<arg name="virtual_ceil" value="12.0"/>
	<arg name="virtual_ground" value="0.5"/>
	<arg name="flight_type" default="2"/>  <!-- 1:MANUAL_TARGET; 2:PRESET_TARGET -->
	<arg name="traj_yaw_dot_max_per_sec" value="7.0"/>
	<arg name="traj_yaw_dot_dot_max_per_sec" value="14.0"/>
	<arg name="traj_spread_commanded_yaw_over_traj" value="true"/>
	<arg name="traj_commanded_yaw_dynamic_threshold" value="0.05"/>
	<arg name="traj_commanded_yaw_init_window_sec" value="0.12"/>

	<!-- mission behaviour -->
	<arg name="auto_repeat_mission" value="false"/>
	<arg name="waypoint_hold_velocity_thresh" value="0.35"/>
	<arg name="gimbal_pitch_reach_thresh_deg" value="5.0"/>
	<arg name="gimbal_waypoint_reach_thresh_m" value="0.45"/>
	<arg name="gimbal_action_waypoint_indices" value="0,2,3,5,6,8,9,11,12,14,15,17,18,20,21,23,24,26,27,29"/>

	<!-- 10-path chained mission total waypoints -->
	<arg name="point_num" value="30"/>

	<!-- run_in_sim_realworld.xml supports target0..target10 only -->
	<arg name="target0_x" value="1.917"/>
	<arg name="target0_y" value="1.376"/>
	<arg name="target0_z" value="4.339"/>
	<arg name="target0_yaw" value="-0.366"/>
	<arg name="target0_cam_pitch" value="-6174"/>

	<arg name="target1_x" value="2.044"/>
	<arg name="target1_y" value="1.388"/>
	<arg name="target1_z" value="2.893"/>
	<arg name="target1_yaw" value="-0.357"/>
	<arg name="target1_cam_pitch" value="0"/>

	<arg name="target2_x" value="2.000"/>
	<arg name="target2_y" value="1.380"/>
	<arg name="target2_z" value="1.128"/>
	<arg name="target2_yaw" value="-0.369"/>
	<arg name="target2_cam_pitch" value="333"/>

	<arg name="target3_x" value="2.040"/>
	<arg name="target3_y" value="1.453"/>
	<arg name="target3_z" value="4.262"/>
	<arg name="target3_yaw" value="-0.348"/>
	<arg name="target3_cam_pitch" value="-6174"/>

	<arg name="target4_x" value="2.046"/>
	<arg name="target4_y" value="1.280"/>
	<arg name="target4_z" value="2.873"/>
	<arg name="target4_yaw" value="-0.303"/>
	<arg name="target4_cam_pitch" value="0"/>

	<arg name="target5_x" value="1.855"/>
	<arg name="target5_y" value="1.322"/>
	<arg name="target5_z" value="1.076"/>
	<arg name="target5_yaw" value="-0.348"/>
	<arg name="target5_cam_pitch" value="333"/>

	<arg name="target6_x" value="1.872"/>
	<arg name="target6_y" value="1.377"/>
	<arg name="target6_z" value="4.354"/>
	<arg name="target6_yaw" value="-0.308"/>
	<arg name="target6_cam_pitch" value="-6174"/>

	<arg name="target7_x" value="1.889"/>
	<arg name="target7_y" value="1.322"/>
	<arg name="target7_z" value="2.808"/>
	<arg name="target7_yaw" value="-0.353"/>
	<arg name="target7_cam_pitch" value="0"/>

	<arg name="target8_x" value="2.062"/>
	<arg name="target8_y" value="1.231"/>
	<arg name="target8_z" value="1.049"/>
	<arg name="target8_yaw" value="-0.374"/>
	<arg name="target8_cam_pitch" value="333"/>

	<arg name="target9_x" value="1.931"/>
	<arg name="target9_y" value="1.252"/>
	<arg name="target9_z" value="4.205"/>
	<arg name="target9_yaw" value="-0.291"/>
	<arg name="target9_cam_pitch" value="-6174"/>

	<arg name="target10_x" value="2.322"/>
	<arg name="target10_y" value="1.355"/>
	<arg name="target10_z" value="2.962"/>
	<arg name="target10_yaw" value="-0.386"/>
	<arg name="target10_cam_pitch" value="0"/>

	<!-- Inject waypoint11+ directly to planner fsm namespace -->
	<param name="/drone_0_ego_planner_node/fsm/waypoint_num" value="30"/>
	<param name="/drone_0_ego_planner_node/fsm/auto_repeat_mission" value="$(arg auto_repeat_mission)"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint_hold_velocity_thresh" value="$(arg waypoint_hold_velocity_thresh)"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint11_x" value="2.014"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint11_y" value="1.398"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint11_z" value="1.101"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint11_yaw" value="-0.424"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint11_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint12_x" value="1.849"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint12_y" value="1.491"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint12_z" value="4.388"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint12_yaw" value="-0.485"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint12_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint13_x" value="2.056"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint13_y" value="1.335"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint13_z" value="2.896"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint13_yaw" value="-0.388"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint13_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint14_x" value="2.082"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint14_y" value="1.412"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint14_z" value="1.077"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint14_yaw" value="-0.384"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint14_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint15_x" value="2.027"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint15_y" value="1.272"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint15_z" value="4.337"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint15_yaw" value="-0.382"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint15_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint16_x" value="2.000"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint16_y" value="1.387"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint16_z" value="2.998"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint16_yaw" value="-0.349"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint16_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint17_x" value="1.746"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint17_y" value="1.499"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint17_z" value="1.305"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint17_yaw" value="-0.430"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint17_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint18_x" value="1.928"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint18_y" value="1.174"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint18_z" value="4.291"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint18_yaw" value="-0.359"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint18_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint19_x" value="2.064"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint19_y" value="1.284"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint19_z" value="2.960"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint19_yaw" value="-0.383"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint19_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint20_x" value="1.994"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint20_y" value="1.318"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint20_z" value="0.937"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint20_yaw" value="-0.340"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint20_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint21_x" value="1.940"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint21_y" value="1.453"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint21_z" value="4.311"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint21_yaw" value="-0.311"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint21_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint22_x" value="2.023"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint22_y" value="1.245"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint22_z" value="2.946"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint22_yaw" value="-0.374"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint22_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint23_x" value="1.935"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint23_y" value="1.390"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint23_z" value="1.163"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint23_yaw" value="-0.408"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint23_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint24_x" value="2.058"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint24_y" value="1.265"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint24_z" value="4.370"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint24_yaw" value="-0.393"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint24_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint25_x" value="1.972"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint25_y" value="1.347"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint25_z" value="2.894"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint25_yaw" value="-0.261"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint25_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint26_x" value="2.157"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint26_y" value="1.453"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint26_z" value="1.223"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint26_yaw" value="-0.409"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint26_cam_pitch" value="333"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint27_x" value="1.865"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint27_y" value="1.408"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint27_z" value="4.466"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint27_yaw" value="-0.420"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint27_cam_pitch" value="-6174"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint28_x" value="2.173"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_y" value="1.345"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_z" value="2.770"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_yaw" value="-0.449"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint28_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint29_x" value="2.064"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_y" value="1.330"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_z" value="1.063"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_yaw" value="-0.385"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint29_cam_pitch" value="333"/>

	<group if="$(arg enable_dynamic_obstacle_detection)">
		<node pkg="swarm_bridge" name="traj2odom_node" type="traj2odom_node" output="screen">
			<param name="odom_topic" value="$(arg odom_topic)" />
		</node>

		<include file="$(find dynamic_obstacle_detection)/launch/dynamic_obstacle_detection_indoor.launch" >
			<arg name="odom_topic" value="$(arg odom_topic)" />
			<arg name="cloud_topic" value="$(arg cloud_topic)" />
		</include>
	</group>

	<include file="$(find ego_planner)/launch/include/run_in_sim_realworld.xml">
		<arg name="drone_id" value="0"/>
		<arg name="odom_topic" value="$(arg odom_topic)"/>
		<arg name="cloud_topic" value="$(arg cloud_topic)"/>
		<arg name="max_vel" value="0.6" />
		<arg name="max_acc" value="10.0" />
		<arg name="max_jer" value="10.0" />
		<arg name="planning_horizon" value="20" />
		<arg name="thresh_replan_time" value="0.5"/>
		<arg name="traj_yaw_dot_max_per_sec" value="$(arg traj_yaw_dot_max_per_sec)"/>
		<arg name="traj_yaw_dot_dot_max_per_sec" value="$(arg traj_yaw_dot_dot_max_per_sec)"/>
		<arg name="traj_spread_commanded_yaw_over_traj" value="$(arg traj_spread_commanded_yaw_over_traj)"/>
		<arg name="traj_commanded_yaw_dynamic_threshold" value="$(arg traj_commanded_yaw_dynamic_threshold)"/>
		<arg name="traj_commanded_yaw_init_window_sec" value="$(arg traj_commanded_yaw_init_window_sec)"/>
		<arg name="local_update_range_x" value="30.0" />
		<arg name="local_update_range_y" value="30.0" />
		<arg name="local_update_range_z" value="3.0" />
		<arg name="obstacles_inflation" value="0.2" />
		<arg name="flight_type" value="$(arg flight_type)"/>

		<arg name="point_num" value="$(arg point_num)"/>
		<arg name="target0_x" value="$(arg target0_x)"/>
		<arg name="target0_y" value="$(arg target0_y)"/>
		<arg name="target0_z" value="$(arg target0_z)"/>
		<arg name="target0_yaw" value="$(arg target0_yaw)"/>
		<arg name="target0_cam_pitch" value="$(arg target0_cam_pitch)"/>
		<arg name="target1_x" value="$(arg target1_x)"/>
		<arg name="target1_y" value="$(arg target1_y)"/>
		<arg name="target1_z" value="$(arg target1_z)"/>
		<arg name="target1_yaw" value="$(arg target1_yaw)"/>
		<arg name="target1_cam_pitch" value="$(arg target1_cam_pitch)"/>
		<arg name="target2_x" value="$(arg target2_x)"/>
		<arg name="target2_y" value="$(arg target2_y)"/>
		<arg name="target2_z" value="$(arg target2_z)"/>
		<arg name="target2_yaw" value="$(arg target2_yaw)"/>
		<arg name="target2_cam_pitch" value="$(arg target2_cam_pitch)"/>
		<arg name="target3_x" value="$(arg target3_x)"/>
		<arg name="target3_y" value="$(arg target3_y)"/>
		<arg name="target3_z" value="$(arg target3_z)"/>
		<arg name="target3_yaw" value="$(arg target3_yaw)"/>
		<arg name="target3_cam_pitch" value="$(arg target3_cam_pitch)"/>
		<arg name="target4_x" value="$(arg target4_x)"/>
		<arg name="target4_y" value="$(arg target4_y)"/>
		<arg name="target4_z" value="$(arg target4_z)"/>
		<arg name="target4_yaw" value="$(arg target4_yaw)"/>
		<arg name="target4_cam_pitch" value="$(arg target4_cam_pitch)"/>
		<arg name="target5_x" value="$(arg target5_x)"/>
		<arg name="target5_y" value="$(arg target5_y)"/>
		<arg name="target5_z" value="$(arg target5_z)"/>
		<arg name="target5_yaw" value="$(arg target5_yaw)"/>
		<arg name="target5_cam_pitch" value="$(arg target5_cam_pitch)"/>
		<arg name="target6_x" value="$(arg target6_x)"/>
		<arg name="target6_y" value="$(arg target6_y)"/>
		<arg name="target6_z" value="$(arg target6_z)"/>
		<arg name="target6_yaw" value="$(arg target6_yaw)"/>
		<arg name="target6_cam_pitch" value="$(arg target6_cam_pitch)"/>
		<arg name="target7_x" value="$(arg target7_x)"/>
		<arg name="target7_y" value="$(arg target7_y)"/>
		<arg name="target7_z" value="$(arg target7_z)"/>
		<arg name="target7_yaw" value="$(arg target7_yaw)"/>
		<arg name="target7_cam_pitch" value="$(arg target7_cam_pitch)"/>
		<arg name="target8_x" value="$(arg target8_x)"/>
		<arg name="target8_y" value="$(arg target8_y)"/>
		<arg name="target8_z" value="$(arg target8_z)"/>
		<arg name="target8_yaw" value="$(arg target8_yaw)"/>
		<arg name="target8_cam_pitch" value="$(arg target8_cam_pitch)"/>
		<arg name="target9_x" value="$(arg target9_x)"/>
		<arg name="target9_y" value="$(arg target9_y)"/>
		<arg name="target9_z" value="$(arg target9_z)"/>
		<arg name="target9_yaw" value="$(arg target9_yaw)"/>
		<arg name="target9_cam_pitch" value="$(arg target9_cam_pitch)"/>
		<arg name="target10_x" value="$(arg target10_x)"/>
		<arg name="target10_y" value="$(arg target10_y)"/>
		<arg name="target10_z" value="$(arg target10_z)"/>
		<arg name="target10_yaw" value="$(arg target10_yaw)"/>
		<arg name="target10_cam_pitch" value="$(arg target10_cam_pitch)"/>

		<arg name="gimbal_action_waypoint_indices" value="$(arg gimbal_action_waypoint_indices)"/>
		<arg name="gimbal_pitch_reach_thresh_deg" value="$(arg gimbal_pitch_reach_thresh_deg)"/>
		<arg name="gimbal_waypoint_reach_thresh_m" value="$(arg gimbal_waypoint_reach_thresh_m)"/>
		<arg name="auto_repeat_mission" value="$(arg auto_repeat_mission)"/>
		<arg name="waypoint_hold_velocity_thresh" value="$(arg waypoint_hold_velocity_thresh)"/>
		<arg name="virtual_ceil" value="$(arg virtual_ceil)"/>
		<arg name="virtual_ground" value="$(arg virtual_ground)"/>
	</include>

</launch>

	<param name="/drone_0_ego_planner_node/fsm/waypoint34_z" value="2.733"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_yaw" value="-0.538"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_x" value="-5.877"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="3.902"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="3.419"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="0.302"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_x" value="-0.193"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_y" value="7.203"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="2.500"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="-1.444"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="0"/>

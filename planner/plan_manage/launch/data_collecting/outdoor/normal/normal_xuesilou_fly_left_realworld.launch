<launch>
	<arg name="enable_dynamic_obstacle_detection" value="false" />

	<arg name="odom_topic" value="ekf_quat/ekf_odom" />
	<arg name="cloud_topic" value="cloud_registered"/>

	<arg name="virtual_ceil" value="12.0"/>
	<arg name="virtual_ground" value="0.5"/>
	<arg name="flight_type" default="2"/>  <!-- 1:MANUAL_TARGET; 2:PRESET_TARGET -->
	<arg name="traj_yaw_dot_max_per_sec" value="7.0"/>
	<arg name="traj_yaw_dot_dot_max_per_sec" value="14.0"/>
	<arg name="traj_spread_commanded_yaw_over_traj" value="true"/>
	<arg name="traj_commanded_yaw_dynamic_threshold" value="0.05"/>
	<arg name="traj_commanded_yaw_init_window_sec" value="0.12"/>

	<!-- mission behaviour -->
	<arg name="auto_repeat_mission" value="false"/>
	<arg name="waypoint_hold_velocity_thresh" value="0.15"/>
	<arg name="gimbal_pitch_reach_thresh_deg" value="5.0"/>
	<arg name="gimbal_waypoint_reach_thresh_m" value="0.25"/>
	<arg name="gimbal_action_waypoint_indices" value=""/>
	<!-- 10-path chained mission total waypoints -->
	<arg name="point_num" value="60"/>

	<!-- run_in_sim_realworld.xml supports target0..target10 only -->
	<arg name="target0_x" value="-5.324"/>
	<arg name="target0_y" value="4.065"/>
	<arg name="target0_z" value="2.503"/>
	<arg name="target0_yaw" value="0.001"/>
	<arg name="target0_cam_pitch" value="0"/>

	<arg name="target1_x" value="-3.918"/>
	<arg name="target1_y" value="4.050"/>
	<arg name="target1_z" value="2.515"/>
	<arg name="target1_yaw" value="-0.008"/>

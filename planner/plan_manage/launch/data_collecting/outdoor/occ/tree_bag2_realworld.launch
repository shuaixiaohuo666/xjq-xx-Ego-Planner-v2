	<param name="/drone_0_ego_planner_node/fsm/waypoint34_z" value="2.152"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_yaw" value="2.620"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_x" value="23.030"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="-4.300"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="1.733"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="2.631"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="-816"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_x" value="23.187"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="8.914"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="2.659"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="-6978"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint37_z" value="7.023"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_yaw" value="2.676"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_cam_pitch" value="0"/>

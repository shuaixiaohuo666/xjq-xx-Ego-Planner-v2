	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="8.963"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="-0.475"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="-6948"/>

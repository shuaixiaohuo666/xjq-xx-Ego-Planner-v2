	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="3.280"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="1.400"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="-0.453"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="-1692"/>

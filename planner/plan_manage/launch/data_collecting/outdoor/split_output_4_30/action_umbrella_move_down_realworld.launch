	<arg name="target2_z" value="2.427"/>
	<arg name="target2_yaw" value="-0.013"/>
	<arg name="target2_cam_pitch" value="0"/>

	<arg name="target3_x" value="-7.386"/>
	<arg name="target3_y" value="-8.961"/>
	<arg name="target3_z" value="1.270"/>

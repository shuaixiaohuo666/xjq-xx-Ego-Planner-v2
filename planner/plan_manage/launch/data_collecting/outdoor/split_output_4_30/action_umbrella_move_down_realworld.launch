	<arg name="target5_cam_pitch" value="0"/>

	<arg name="target6_x" value="-7.556"/>
	<arg name="target6_y" value="-8.922"/>
	<arg name="target6_z" value="2.281"/>
	<arg name="target6_yaw" value="-0.004"/>
	<arg name="target6_cam_pitch" value="0"/>

	<arg name="target7_x" value="-7.505"/>

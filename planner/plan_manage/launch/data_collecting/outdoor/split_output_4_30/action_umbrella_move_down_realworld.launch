	<param name="/drone_0_ego_planner_node/fsm/waypoint34_z" value="2.304"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_yaw" value="-0.007"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_x" value="-7.390"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="-9.078"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="1.400"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="-0.048"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_x" value="-7.386"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_y" value="-8.929"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="4.967"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="0.003"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint38_y" value="-9.044"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint38_z" value="2.506"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint38_yaw" value="-0.005"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint38_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint33_z" value="3.637"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_yaw" value="-0.050"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_cam_pitch" value="0"/>

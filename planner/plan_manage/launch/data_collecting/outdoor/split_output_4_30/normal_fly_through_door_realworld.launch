	<param name="/drone_0_ego_planner_node/fsm/waypoint33_z" value="2.481"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_yaw" value="-0.046"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint33_cam_pitch" value="0"/>

	<arg name="target6_x" value="6.605"/>
	<arg name="target6_y" value="-2.770"/>
	<arg name="target6_z" value="1.267"/>
	<arg name="target6_yaw" value="0.046"/>
	<arg name="target6_cam_pitch" value="0"/>

	<arg name="target7_x" value="11.760"/>

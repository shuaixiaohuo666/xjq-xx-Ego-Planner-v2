	<param name="/drone_0_ego_planner_node/fsm/waypoint37_z" value="2.258"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_yaw" value="-0.114"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint37_cam_pitch" value="0"/>

	<param name="/drone_0_ego_planner_node/fsm/waypoint38_z" value="1.431"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint38_yaw" value="0.058"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint38_cam_pitch" value="0"/>

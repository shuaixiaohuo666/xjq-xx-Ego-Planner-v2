	<param name="/drone_0_ego_planner_node/fsm/waypoint34_z" value="1.515"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_yaw" value="-0.099"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint34_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_x" value="11.736"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_y" value="-3.220"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_z" value="1.623"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_yaw" value="0.059"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint35_cam_pitch" value="0"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_x" value="4.893"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_y" value="-2.610"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_z" value="2.449"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_yaw" value="-0.006"/>
	<param name="/drone_0_ego_planner_node/fsm/waypoint36_cam_pitch" value="0"/>

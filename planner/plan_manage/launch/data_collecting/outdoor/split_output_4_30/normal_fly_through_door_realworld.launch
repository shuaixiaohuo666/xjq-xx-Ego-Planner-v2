	<arg name="target2_yaw" value="0.005"/>
	<arg name="target2_cam_pitch" value="0"/>

	<arg name="target3_x" value="11.726"/>
	<arg name="target3_y" value="-3.130"/>
	<arg name="target3_z" value="1.407"/>

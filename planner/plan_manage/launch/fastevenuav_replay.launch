<launch>
	<!-- if want to check dynamic_obstacle_detection, add "- -clock"(no space) when play bag and use_sim_time-->
	<!-- <param name="/use_sim_time" value="true"/> -->

    <arg name="map_size_x" value="220.0"/>
	<arg name="map_size_y" value="220.0"/>
    <arg name="map_size_z" value=" 10.0"/>

    <arg name="odom_topic" value="visual_slam/odom" />
	<arg name="cloud_topic" value="cloud_registered" />

	<arg name="init_x" value="0.0"/>
	<arg name="init_y" value="-2.0"/>
	<arg name="init_z" value="2.5"/>

	<arg name="target0_x" value="50.0"/>
	<arg name="target0_y" value="0.0"/>
	<arg name="target0_z" value="2.5"/>
	<arg name="target1_x" value="5.0"/>
	<arg name="target1_y" value="0.0"/>
	<arg name="target1_z" value="3.0"/>

    <!-- RViz 可视化 -->
    <!-- <node name="rviz" pkg="rviz" type="rviz" args="-d $(find ego_planner)/launch/include/fasteventuav.rviz" required="true" /> -->
	
	<!-- 订阅所有广播的轨迹，并将其转换为 Odometry 消息，方便在 RViz 中可视化其他无人机或动态障碍物的预测路径。 -->
	<node pkg="swarm_bridge" name="traj2odom_node" type="traj2odom_node" output="screen">
      <param name="odom_topic" value="$(arg odom_topic)" />
    </node>
	
	<include file="$(find dynamic_obstacle_detection)/launch/dynamic_obstacle_detection.launch" >
		<arg name="odom_topic" value="drone_0_$(arg odom_topic)" />
    	<arg name="cloud_topic" value="$(arg cloud_topic)" />
	</include>

    <include file="$(find ego_planner)/launch/include/run_in_sim_replay.xml">
        <arg name="drone_id" value="0"/>
        <arg name="init_x" value="$(arg init_x)"/>
        <arg name="init_y" value="$(arg init_y)"/>
        <arg name="init_z" value="$(arg init_z)"/>
        <arg name="map_size_x" value="$(arg map_size_x)"/>
        <arg name="map_size_y" value="$(arg map_size_y)"/>
        <arg name="map_size_z" value="$(arg map_size_z)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>

		<arg name="max_vel" value="15.0" />
		<arg name="max_acc" value="20.0" />
		<arg name="max_jer" value="20.0" />
		<arg name="planning_horizon" value="20" />
		<arg name="thresh_replan_time" value="0.5"/>
		<arg name="local_update_range_x" value="30.0" />
    	<arg name="local_update_range_y" value="30.0" />
    	<arg name="local_update_range_z" value="3.0" />
  	 	<arg name="obstacles_inflation" value="0.25" />
        <arg name="flight_type" value="2"/>  <!-- 1:MANUAL_TARGET; 2:PRESET_TARGET -->
		<arg name="virtual_ceil" value="3.5"/>
		<arg name="virtual_ground" value="1.3"/>

		<arg name="point_num" value="1"/>
		<arg name="target0_x" value="$(arg target0_x)"/>
		<arg name="target0_y" value="$(arg target0_y)"/>
		<arg name="target0_z" value="$(arg target0_z)"/>
		<arg name="target1_x" value="$(arg target1_x)"/>
		<arg name="target1_y" value="$(arg target1_y)"/>
		<arg name="target1_z" value="$(arg target1_z)"/>
    </include>

	<node pkg="rosbag" type="play" name="player" output="screen" required="true" args="--start 2 $(find ego_planner)/replay_bags/replay_bag1.bag"/>
	<!-- rosbag filter input.bag output.bag "topic in ['/cloud_registered', 'traj_start_trigger']" -->
	<!-- rosbag filter replay_bag1.bag replay_bag2.bag "t.to_sec() >= 1760264764.66 and t.to_sec() <= 1760264784.66" -->

	<include file="$(find ego_planner)/launch/tf_fix.launch" />
</launch>

<!-- rostopic pub /broadcast_traj_to_planner traj_utils/MINCOTraj '{drone_id: 31, traj_id: 1, start_time: now, des_clearance: 0.2, order: 5, start_p: [40.0, 1.0, 2.5], start_v: [-3.0, 0.0, 0.0], start_a: [0,0,0], end_p: [0.0, 5.0, 2.5], end_v: [-3.0, 0.0, 0.0], end_a: [0,0,0], inner_x: [], inner_y: [], inner_z: [], duration: [10.0]}' -r 1 -->
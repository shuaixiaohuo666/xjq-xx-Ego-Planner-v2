<launch>
    <!-- <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>
    <arg name="map_size_z_"/> -->  <!-- useless -->
    <arg name="odometry_topic"/>
    <arg name="camera_pose_topic"/>
    <arg name="depth_topic"/>
    <arg name="cloud_topic"/>
    <arg name="cx"/>
    <arg name="cy"/>
    <arg name="fx"/>
    <arg name="fy"/>
    <arg name="max_vel"/>
    <arg name="max_acc"/>
    <arg name="max_jer"/>
    <arg name="planning_horizon"/>
    <arg name="point_num"/>
    <arg name="point0_x"/>
    <arg name="point0_y"/>
    <arg name="point0_z"/>
    <arg name="point0_yaw" default="0.0"/>
    <arg name="point0_cam_pitch" default="0.0"/>
    <arg name="point1_x"/>
    <arg name="point1_y"/>
    <arg name="point1_z"/>
    <arg name="point1_yaw" default="0.0"/>
    <arg name="point1_cam_pitch" default="0.0"/>
    <arg name="point2_x"/>
    <arg name="point2_y"/>
    <arg name="point2_z"/>
    <arg name="point2_yaw" default="0.0"/>
    <arg name="point2_cam_pitch" default="0.0"/>
    <arg name="point3_x"/>
    <arg name="point3_y"/>
    <arg name="point3_z"/>
    <arg name="point3_yaw" default="0.0"/>
    <arg name="point3_cam_pitch" default="0.0"/>
    <arg name="point4_x"/>
    <arg name="point4_y"/>
    <arg name="point4_z"/>
    <arg name="point4_yaw" default="0.0"/>
    <arg name="point4_cam_pitch" default="0.0"/>
    <arg name="point5_x"/>
    <arg name="point5_y"/>
    <arg name="point5_z"/>
    <arg name="point5_yaw" default="0.0"/>
    <arg name="point5_cam_pitch" default="0.0"/>
    <arg name="point6_x"/>
    <arg name="point6_y"/>
    <arg name="point6_z"/>
    <arg name="point6_yaw" default="0.0"/>
    <arg name="point6_cam_pitch" default="0.0"/>
    <arg name="point7_x"/>
    <arg name="point7_y"/>
    <arg name="point7_z"/>
    <arg name="point7_yaw" default="0.0"/>
    <arg name="point7_cam_pitch" default="0.0"/>
    <arg name="point8_x"/>
    <arg name="point8_y"/>
    <arg name="point8_z"/>
    <arg name="point8_yaw" default="0.0"/>
    <arg name="point8_cam_pitch" default="0.0"/>
    <arg name="point9_x"/>
    <arg name="point9_y"/>
    <arg name="point9_z"/>
    <arg name="point9_yaw" default="0.0"/>
    <arg name="point9_cam_pitch" default="0.0"/>
    <arg name="point10_x"/>
    <arg name="point10_y"/>
    <arg name="point10_z"/>
    <arg name="point10_yaw" default="0.0"/>
    <arg name="point10_cam_pitch" default="0.0"/>
    <arg name="gimbal_action_waypoint_indices" default=""/>
    <arg name="gimbal_pitch_reach_thresh_deg" default="2.0"/>
    <arg name="gimbal_waypoint_reach_thresh_m" default="0.25"/>
    <arg name="auto_repeat_mission" default="true"/>
    <arg name="waypoint_hold_velocity_thresh" default="0.15"/>
    <arg name="flight_type"/>
    <arg name="use_multitopology_trajs"/>
    <arg name="drone_id"/>
    <arg name="thresh_replan_time" default="1.0"/>

    <arg name="local_update_range_x" default="30.0" />
    <arg name="local_update_range_y" default="30.0" />
    <arg name="local_update_range_z" default="3.0" />
    <arg name="obstacles_inflation" default="0.3" />  <!-- should be larger than uav-->

    <arg name="virtual_ceil" default="2.0"/>
    <arg name="virtual_ground" default="0.0"/>

    <!-- main node -->
    <!-- <node pkg="ego_planner" name="ego_planner_node" type="ego_planner_node" output="screen" launch-prefix="valgrind"> -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_ego_planner_node" type="ego_planner_node" output="screen">
        <!-- <remap from="~odom_world" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/> -->
        <remap from="~odom_world" to="/$(arg odometry_topic)"/>
        <remap from="~mandatory_stop" to="/mandatory_stop_to_planner"/>
        <remap from="~planning/trajectory" to = "/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/data_display" to = "/drone_$(arg drone_id)_planning/data_display"/>
        <remap from="~planning/broadcast_traj_send" to = "/broadcast_traj_from_planner"/>
        <remap from="~planning/broadcast_traj_recv" to = "/broadcast_traj_to_planner"/>
        <remap from="~planning/heartbeat" to = "/drone_$(arg drone_id)_traj_server/heartbeat"/>
        <remap from="/goal" to = "/goal_with_id"/>
        <!-- <remap from="~grid_map/odom" to="/drone_$(arg drone_id)_$(arg odometry_topic)"/> -->
        <remap from="~grid_map/odom" to="/$(arg odometry_topic)"/>
        <remap from="~grid_map/cloud" to="$(arg cloud_topic)"/>
        <remap from="~grid_map/pose"   to = "/drone_$(arg drone_id)_$(arg camera_pose_topic)"/>  <!-- already use lidar, so no need -->
        <remap from="~grid_map/depth" to = "/drone_$(arg drone_id)_$(arg depth_topic)"/>  <!-- already use lidar, so no need -->
        <!-- planning fsm -->
        <param name="fsm/flight_type" value="$(arg flight_type)" type="int"/>
        <param name="fsm/thresh_replan_time" value="$(arg thresh_replan_time)" type="double"/>
        <param name="fsm/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <!--always set to 1.5 times grater than sensing horizen-->
        <param name="fsm/emergency_time" value="1.0" type="double"/>
        <param name="fsm/realworld_experiment" value="true"/>
        <param name="fsm/use_rc_trigger_in_manual" value="true"/>
        <param name="fsm/fail_safe" value="true"/>
        <param name="fsm/waypoint_num" value="$(arg point_num)" type="int"/>
        <param name="fsm/gimbal_action_waypoint_indices" value="$(arg gimbal_action_waypoint_indices)"/>
        <param name="fsm/gimbal_pitch_reach_thresh_deg" value="$(arg gimbal_pitch_reach_thresh_deg)" type="double"/>
        <param name="fsm/gimbal_waypoint_reach_thresh_m" value="$(arg gimbal_waypoint_reach_thresh_m)" type="double"/>
        <param name="fsm/auto_repeat_mission" value="$(arg auto_repeat_mission)" type="bool"/>
        <param name="fsm/waypoint_hold_velocity_thresh" value="$(arg waypoint_hold_velocity_thresh)" type="double"/>
        <param name="fsm/waypoint0_x" value="$(arg point0_x)" type="double"/>
        <param name="fsm/waypoint0_y" value="$(arg point0_y)" type="double"/>
        <param name="fsm/waypoint0_z" value="$(arg point0_z)" type="double"/>
        <param name="fsm/waypoint0_yaw" value="$(arg point0_yaw)" type="double"/>
        <param name="fsm/waypoint0_cam_pitch" value="$(arg point0_cam_pitch)" type="double"/>
        <param name="fsm/waypoint1_x" value="$(arg point1_x)" type="double"/>
        <param name="fsm/waypoint1_y" value="$(arg point1_y)" type="double"/>
        <param name="fsm/waypoint1_z" value="$(arg point1_z)" type="double"/>
        <param name="fsm/waypoint1_yaw" value="$(arg point1_yaw)" type="double"/>
        <param name="fsm/waypoint1_cam_pitch" value="$(arg point1_cam_pitch)" type="double"/>
        <param name="fsm/waypoint2_x" value="$(arg point2_x)" type="double"/>
        <param name="fsm/waypoint2_y" value="$(arg point2_y)" type="double"/>
        <param name="fsm/waypoint2_z" value="$(arg point2_z)" type="double"/>
        <param name="fsm/waypoint2_yaw" value="$(arg point2_yaw)" type="double"/>
        <param name="fsm/waypoint2_cam_pitch" value="$(arg point2_cam_pitch)" type="double"/>
        <param name="fsm/waypoint3_x" value="$(arg point3_x)" type="double"/>
        <param name="fsm/waypoint3_y" value="$(arg point3_y)" type="double"/>
        <param name="fsm/waypoint3_z" value="$(arg point3_z)" type="double"/>
        <param name="fsm/waypoint3_yaw" value="$(arg point3_yaw)" type="double"/>
        <param name="fsm/waypoint3_cam_pitch" value="$(arg point3_cam_pitch)" type="double"/>
        <param name="fsm/waypoint4_x" value="$(arg point4_x)" type="double"/>
        <param name="fsm/waypoint4_y" value="$(arg point4_y)" type="double"/>
        <param name="fsm/waypoint4_z" value="$(arg point4_z)" type="double"/>
        <param name="fsm/waypoint4_yaw" value="$(arg point4_yaw)" type="double"/>
        <param name="fsm/waypoint4_cam_pitch" value="$(arg point4_cam_pitch)" type="double"/>
        <param name="fsm/waypoint5_x" value="$(arg point5_x)" type="double"/>
        <param name="fsm/waypoint5_y" value="$(arg point5_y)" type="double"/>
        <param name="fsm/waypoint5_z" value="$(arg point5_z)" type="double"/>
        <param name="fsm/waypoint5_yaw" value="$(arg point5_yaw)" type="double"/>
        <param name="fsm/waypoint5_cam_pitch" value="$(arg point5_cam_pitch)" type="double"/>
        <param name="fsm/waypoint6_x" value="$(arg point6_x)" type="double"/>
        <param name="fsm/waypoint6_y" value="$(arg point6_y)" type="double"/>
        <param name="fsm/waypoint6_z" value="$(arg point6_z)" type="double"/>
        <param name="fsm/waypoint6_yaw" value="$(arg point6_yaw)" type="double"/>
        <param name="fsm/waypoint6_cam_pitch" value="$(arg point6_cam_pitch)" type="double"/>
        <param name="fsm/waypoint7_x" value="$(arg point7_x)" type="double"/>
        <param name="fsm/waypoint7_y" value="$(arg point7_y)" type="double"/>
        <param name="fsm/waypoint7_z" value="$(arg point7_z)" type="double"/>
        <param name="fsm/waypoint7_yaw" value="$(arg point7_yaw)" type="double"/>
        <param name="fsm/waypoint7_cam_pitch" value="$(arg point7_cam_pitch)" type="double"/>
        <param name="fsm/waypoint8_x" value="$(arg point8_x)" type="double"/>
        <param name="fsm/waypoint8_y" value="$(arg point8_y)" type="double"/>
        <param name="fsm/waypoint8_z" value="$(arg point8_z)" type="double"/>
        <param name="fsm/waypoint8_yaw" value="$(arg point8_yaw)" type="double"/>
        <param name="fsm/waypoint8_cam_pitch" value="$(arg point8_cam_pitch)" type="double"/>
        <param name="fsm/waypoint9_x" value="$(arg point9_x)" type="double"/>
        <param name="fsm/waypoint9_y" value="$(arg point9_y)" type="double"/>
        <param name="fsm/waypoint9_z" value="$(arg point9_z)" type="double"/>
        <param name="fsm/waypoint9_yaw" value="$(arg point9_yaw)" type="double"/>
        <param name="fsm/waypoint9_cam_pitch" value="$(arg point9_cam_pitch)" type="double"/>
        <param name="fsm/waypoint10_x" value="$(arg point10_x)" type="double"/>
        <param name="fsm/waypoint10_y" value="$(arg point10_y)" type="double"/>
        <param name="fsm/waypoint10_z" value="$(arg point10_z)" type="double"/>
        <param name="fsm/waypoint10_yaw" value="$(arg point10_yaw)" type="double"/>
        <param name="fsm/waypoint10_cam_pitch" value="$(arg point10_cam_pitch)" type="double"/>
        <param name="planning_delay" value="0.05" type="double"/>
        <param name="print_trj_vaj" value="false" type="bool"/>
        
        <param name="grid_map/resolution" value="0.2" />
        <!-- <param name="grid_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="grid_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="grid_map/map_size_z" value="$(arg map_size_z_)" /> -->  <!-- useless -->
        <param name="grid_map/local_update_range_x" value="$(arg local_update_range_x)" />
        <param name="grid_map/local_update_range_y" value="$(arg local_update_range_y)" />
        <param name="grid_map/local_update_range_z" value="$(arg local_update_range_z)" />  <!-- different meaning between grid_map.cpp and grid_map_bigmap.cpp -->
        <param name="grid_map/obstacles_inflation" value="$(arg obstacles_inflation)" />  <!-- should be larger than uav-->
        <param name="grid_map/local_map_margin" value="10"/>
        <param name="grid_map/enable_virtual_wall" value="true"/>
        <param name="grid_map/virtual_ceil" value="$(arg virtual_ceil)"/>
        <param name="grid_map/virtual_ground" value="$(arg virtual_ground)"/>
        <param name="grid_map/ground_height" value="-0.01"/>
        <!-- camera parameter -->
        <param name="grid_map/cx" value="$(arg cx)"/>
        <param name="grid_map/cy" value="$(arg cy)"/>
        <param name="grid_map/fx" value="$(arg fx)"/>
        <param name="grid_map/fy" value="$(arg fy)"/>
        <!-- depth filter -->
        <param name="grid_map/use_depth_filter" value="true"/>
        <param name="grid_map/depth_filter_tolerance" value="0.15"/>
        <param name="grid_map/depth_filter_maxdist" value="5.0"/>
        <param name="grid_map/depth_filter_mindist" value="0.2"/>
        <param name="grid_map/depth_filter_margin" value="2"/>
        <param name="grid_map/k_depth_scaling_factor" value="1000.0"/>
        <param name="grid_map/skip_pixel" value="2"/>
        <!-- local fusion -->
        <param name="grid_map/p_hit" value="0.65"/>
        <param name="grid_map/p_miss" value="0.35"/>
        <param name="grid_map/p_min" value="0.12"/>
        <param name="grid_map/p_max" value="0.90"/>
        <param name="grid_map/p_occ" value="0.80"/>
        <param name="grid_map/fading_time" value="0.25"/>  <!-- 1000.0 -->
        <param name="grid_map/min_ray_length" value="0.2"/>  <!-- relate to lidar-->
        <param name="grid_map/max_ray_length" value="40.0"/>  <!-- relate to lidar-->
        <param name="grid_map/visualization_truncate_height" value="1.9"/>
        <param name="grid_map/show_occ_time" value="false"/>
        <param name="grid_map/pose_type" value="-10000"/>  <!-- POSE_STAMPED = 1, ODOMETRY = 2, INVALID_IDX = -10000-->
        <param name="grid_map/frame_id" value="world"/>
        <!-- planner manager -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/polyTraj_piece_length" value="1.5" type="double"/>
        <param name="manager/feasibility_tolerance" value="0.05" type="double"/>
        <param name="manager/planning_horizon" value="$(arg planning_horizon)" type="double"/>
        <param name="manager/use_multitopology_trajs" value="$(arg use_multitopology_trajs)" type="bool"/>
        <param name="manager/drone_id" value="$(arg drone_id)"/>
        <!-- trajectory optimization -->
        <param name="optimization/constraint_points_perPiece" value="5" type="int"/>
        <param name="optimization/weight_obstacle" value="10000.0" type="double"/>
        <param name="optimization/weight_obstacle_soft" value="5000.0" type="double"/>
        <param name="optimization/weight_swarm" value="10000.0" type="double"/>
        <param name="optimization/weight_feasibility" value="10000.0" type="double"/>
        <param name="optimization/weight_sqrvariance" value="10000.0" type="double"/>
        <param name="optimization/weight_time" value="10.0" type="double"/>
        <param name="optimization/obstacle_clearance" value="0.1" type="double"/>
        <param name="optimization/obstacle_clearance_soft" value="0.5" type="double"/>
        <param name="optimization/swarm_clearance" value="0.4" type="double"/> <!-- heterogeneous support: my required clearance -->
        <param name="optimization/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="optimization/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="optimization/max_jer" value="$(arg max_jer)" type="double"/>
        <param name="optimization/max_iterations" value="1000" type="int"/>
        <param name="optimization/delta" value="1.0e-7" type="double"/>
        <param name="optimization/record_opt" value="true"/>
    </node>
</launch>

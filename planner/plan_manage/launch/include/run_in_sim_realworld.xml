<launch>
    <!-- size of map, change the size inflate x, y, z according to your application -->
    <arg name="drone_id" default="0"/>
    <!-- <arg name="map_size_x"/>
    <arg name="map_size_y"/>
    <arg name="map_size_z"/> -->  <!-- useless -->
    <!-- <arg name="init_x"/>
    <arg name="init_y"/>
    <arg name="init_z"/> -->  <!-- useless -->
    <arg name="flight_type" default="2"/>
    <arg name="point_num" default="1"/>
    <arg name="target0_x" default="0.0"/>
    <arg name="target0_y" default="0.0"/>
    <arg name="target0_z" default="0.0"/>
    <arg name="target0_yaw" default="0.0"/>
    <arg name="target0_cam_pitch" default="0.0"/>
    <arg name="target1_x" default="0.0"/>
    <arg name="target1_y" default="0.0"/>
    <arg name="target1_z" default="0.0"/>
    <arg name="target1_yaw" default="0.0"/>
    <arg name="target1_cam_pitch" default="0.0"/>
    <arg name="target2_x" default="0.0"/>
    <arg name="target2_y" default="0.0"/>
    <arg name="target2_z" default="0.0"/>
    <arg name="target2_yaw" default="0.0"/>
    <arg name="target2_cam_pitch" default="0.0"/>
    <arg name="target3_x" default="0.0"/>
    <arg name="target3_y" default="0.0"/>
    <arg name="target3_z" default="0.0"/>
    <arg name="target3_yaw" default="0.0"/>
    <arg name="target3_cam_pitch" default="0.0"/>
    <arg name="target4_x" default="0.0"/>
    <arg name="target4_y" default="0.0"/>
    <arg name="target4_z" default="0.0"/>
    <arg name="target4_yaw" default="0.0"/>
    <arg name="target4_cam_pitch" default="0.0"/>
    <arg name="target5_x" default="0.0"/>
    <arg name="target5_y" default="0.0"/>
    <arg name="target5_z" default="0.0"/>
    <arg name="target5_yaw" default="0.0"/>
    <arg name="target5_cam_pitch" default="0.0"/>
    <arg name="target6_x" default="0.0"/>
    <arg name="target6_y" default="0.0"/>
    <arg name="target6_z" default="0.0"/>
    <arg name="target6_yaw" default="0.0"/>
    <arg name="target6_cam_pitch" default="0.0"/>
    <arg name="target7_x" default="0.0"/>
    <arg name="target7_y" default="0.0"/>
    <arg name="target7_z" default="0.0"/>
    <arg name="target7_yaw" default="0.0"/>
    <arg name="target7_cam_pitch" default="0.0"/>
    <arg name="target8_x" default="0.0"/>
    <arg name="target8_y" default="0.0"/>
    <arg name="target8_z" default="0.0"/>
    <arg name="target8_yaw" default="0.0"/>
    <arg name="target8_cam_pitch" default="0.0"/>
    <arg name="target9_x" default="0.0"/>
    <arg name="target9_y" default="0.0"/>
    <arg name="target9_z" default="0.0"/>
    <arg name="target9_yaw" default="0.0"/>
    <arg name="target9_cam_pitch" default="0.0"/>
    <arg name="target10_x" default="0.0"/>
    <arg name="target10_y" default="0.0"/>
    <arg name="target10_z" default="0.0"/>
    <arg name="target10_yaw" default="0.0"/>
    <arg name="target10_cam_pitch" default="0.0"/>
    <arg name="gimbal_action_waypoint_indices" default=""/>
    <arg name="gimbal_pitch_reach_thresh_deg" default="2.0"/>
    <arg name="gimbal_waypoint_reach_thresh_m" default="0.25"/>
    <arg name="auto_repeat_mission" default="true"/>
    <arg name="waypoint_hold_velocity_thresh" default="0.15"/>
    <!-- VLA realworld interface is fixed in the FSM:
         subscribe: /vla_waypoint   (quadrotor_msgs/VlaWaypoint)
         publish:   /vla_status     (quadrotor_msgs/VlaStatus)
         behavior:  only accept next command when planner reports IDLE/DONE;
                    BUSY state rejects newly arriving commands. -->
    <arg name="max_vel" default="1.5" />
    <arg name="max_acc" default="6.0" />
    <arg name="max_jer" default="20.0" />
    <arg name="planning_horizon" default="7.5" />
    <arg name="thresh_replan_time" default="1.0"/>
    <arg name="traj_yaw_dot_max_per_sec" default="1.2"/>
    <arg name="traj_yaw_dot_dot_max_per_sec" default="3.5"/>
    <arg name="traj_spread_commanded_yaw_over_traj" default="true"/>
    <arg name="traj_commanded_yaw_dynamic_threshold" default="0.2"/>
    <arg name="traj_commanded_yaw_init_window_sec" default="0.2"/>
    <arg name="traj_commanded_yaw_reach_ratio" default="0.8"/>

    <arg name="local_update_range_x" />
    <arg name="local_update_range_y" />
    <arg name="local_update_range_z" />
    <arg name="obstacles_inflation" />  <!-- should be larger than uav-->

    <arg name="virtual_ceil" default="2.0"/>
    <arg name="virtual_ground" default="0.0"/>

    <!-- topic of your odometry such as VIO or LIO -->
    <arg name="odom_topic"/>
    <arg name="cloud_topic"/>
    <!-- main algorithm params -->
    <include file="$(find ego_planner)/launch/include/advanced_param_realworld.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <!-- <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/> -->  <!-- useless -->
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <!-- camera pose: transform of camera frame in the world frame -->
        <!-- depth topic: depth image, 640x480 by default -->
        <!-- don't set cloud_topic if you already set these ones! -->
        <arg name="camera_pose_topic" value="pcl_render_node/camera_pose"/>
        <arg name="depth_topic" value="pcl_render_node/depth"/>
        <!-- topic of point cloud measurement, such as from LIDAR  -->
        <!-- don't set camera pose and depth, if you already set this one! -->
        <arg name="cloud_topic" value="$(arg cloud_topic)"/>  <!-- <arg name="cloud_topic" value="pcl_render_node/cloud"/> -->
        <!-- intrinsic params of the depth camera -->
        <arg name="cx" value="321.04638671875"/>
        <arg name="cy" value="243.44969177246094"/>
        <arg name="fx" value="387.229248046875"/>
        <arg name="fy" value="387.229248046875"/>
        <!-- maximum velocity, acceleration and jerk the drone will reach -->
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="max_jer" value="$(arg max_jer)" />
        <!--always set to 1.5 times grater than sensing horizen-->
        <arg name="planning_horizon" value="$(arg planning_horizon)" />
        <arg name="use_multitopology_trajs" value="false" />
        <!-- 1: use 2D Nav Goal to select goal  -->
        <!-- 2: use global waypoints below  -->
        <arg name="flight_type" value="$(arg flight_type)" />
        <arg name="thresh_replan_time" value="$(arg thresh_replan_time)"/>
        <arg name="local_update_range_x" value="$(arg local_update_range_x)" />
        <arg name="local_update_range_y" value="$(arg local_update_range_y)" />
        <arg name="local_update_range_z" value="$(arg local_update_range_z)" />
        <arg name="obstacles_inflation" value="$(arg obstacles_inflation)" />
        <!-- global waypoints -->
        <!-- It generates a piecewise min-snap traj passing all waypoints -->
        <arg name="point_num" value="$(arg point_num)" />
        <arg name="point0_x" value="$(arg target0_x)" />
        <arg name="point0_y" value="$(arg target0_y)" />
        <arg name="point0_z" value="$(arg target0_z)" />
        <arg name="point0_yaw" value="$(arg target0_yaw)" />
        <arg name="point0_cam_pitch" value="$(arg target0_cam_pitch)" />
        <arg name="point1_x" value="$(arg target1_x)" />
        <arg name="point1_y" value="$(arg target1_y)" />
        <arg name="point1_z" value="$(arg target1_z)" />
        <arg name="point1_yaw" value="$(arg target1_yaw)" />
        <arg name="point1_cam_pitch" value="$(arg target1_cam_pitch)" />
        <arg name="point2_x" value="$(arg target2_x)" />
        <arg name="point2_y" value="$(arg target2_y)" />
        <arg name="point2_z" value="$(arg target2_z)" />
        <arg name="point2_yaw" value="$(arg target2_yaw)" />
        <arg name="point2_cam_pitch" value="$(arg target2_cam_pitch)" />
        <arg name="point3_x" value="$(arg target3_x)" />
        <arg name="point3_y" value="$(arg target3_y)" />
        <arg name="point3_z" value="$(arg target3_z)" />
        <arg name="point3_yaw" value="$(arg target3_yaw)" />
        <arg name="point3_cam_pitch" value="$(arg target3_cam_pitch)" />
        <arg name="point4_x" value="$(arg target4_x)" />
        <arg name="point4_y" value="$(arg target4_y)" />
        <arg name="point4_z" value="$(arg target4_z)" />
        <arg name="point4_yaw" value="$(arg target4_yaw)" />
        <arg name="point4_cam_pitch" value="$(arg target4_cam_pitch)" />
            <arg name="point5_x" value="$(arg target5_x)" />
            <arg name="point5_y" value="$(arg target5_y)" />
            <arg name="point5_z" value="$(arg target5_z)" />
            <arg name="point5_yaw" value="$(arg target5_yaw)" />
            <arg name="point5_cam_pitch" value="$(arg target5_cam_pitch)" />
            <arg name="point6_x" value="$(arg target6_x)" />
            <arg name="point6_y" value="$(arg target6_y)" />
            <arg name="point6_z" value="$(arg target6_z)" />
            <arg name="point6_yaw" value="$(arg target6_yaw)" />
            <arg name="point6_cam_pitch" value="$(arg target6_cam_pitch)" />
            <arg name="point7_x" value="$(arg target7_x)" />
            <arg name="point7_y" value="$(arg target7_y)" />
            <arg name="point7_z" value="$(arg target7_z)" />
            <arg name="point7_yaw" value="$(arg target7_yaw)" />
            <arg name="point7_cam_pitch" value="$(arg target7_cam_pitch)" />
            <arg name="point8_x" value="$(arg target8_x)" />
            <arg name="point8_y" value="$(arg target8_y)" />
            <arg name="point8_z" value="$(arg target8_z)" />
            <arg name="point8_yaw" value="$(arg target8_yaw)" />
            <arg name="point8_cam_pitch" value="$(arg target8_cam_pitch)" />
            <arg name="point9_x" value="$(arg target9_x)" />
            <arg name="point9_y" value="$(arg target9_y)" />
            <arg name="point9_z" value="$(arg target9_z)" />
            <arg name="point9_yaw" value="$(arg target9_yaw)" />
            <arg name="point9_cam_pitch" value="$(arg target9_cam_pitch)" />
            <arg name="point10_x" value="$(arg target10_x)" />
            <arg name="point10_y" value="$(arg target10_y)" />
            <arg name="point10_z" value="$(arg target10_z)" />
            <arg name="point10_yaw" value="$(arg target10_yaw)" />
            <arg name="point10_cam_pitch" value="$(arg target10_cam_pitch)" />
            <arg name="gimbal_action_waypoint_indices" value="$(arg gimbal_action_waypoint_indices)"/>
            <arg name="gimbal_pitch_reach_thresh_deg" value="$(arg gimbal_pitch_reach_thresh_deg)"/>
            <arg name="gimbal_waypoint_reach_thresh_m" value="$(arg gimbal_waypoint_reach_thresh_m)"/>
            <arg name="auto_repeat_mission" value="$(arg auto_repeat_mission)"/>
            <arg name="waypoint_hold_velocity_thresh" value="$(arg waypoint_hold_velocity_thresh)"/>

        <arg name="virtual_ceil" value="$(arg virtual_ceil)"/>
		<arg name="virtual_ground" value="$(arg virtual_ground)"/>
    </include>
    <!-- trajectory server -->
    <!-- For VLA deployment, keep this launch running on the UAV side.
         The ground station should publish world-frame targets to /vla_waypoint,
         then wait for /vla_status feedback before sending the next command. -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="position_cmd" to="drone_$(arg drone_id)_planning/pos_cmd"/>  <!--we only do single drone experiment, so use origin topic name-->
        <remap from="~planning/trajectory" to="drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="~planning/yaw_cmd" to="/drone_$(arg drone_id)_ego_planner_node/planning/yaw_cmd"/>
        <remap from="~planning/use_yaw_cmd" to="/drone_$(arg drone_id)_ego_planner_node/planning/use_yaw_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
        <param name="traj_server/yaw_dot_max_per_sec" value="$(arg traj_yaw_dot_max_per_sec)" type="double"/>
        <param name="traj_server/yaw_dot_dot_max_per_sec" value="$(arg traj_yaw_dot_dot_max_per_sec)" type="double"/>
        <param name="traj_server/spread_commanded_yaw_over_traj" value="$(arg traj_spread_commanded_yaw_over_traj)" type="bool"/>
        <param name="traj_server/commanded_yaw_dynamic_threshold" value="$(arg traj_commanded_yaw_dynamic_threshold)" type="double"/>
        <param name="traj_server/commanded_yaw_init_window_sec" value="$(arg traj_commanded_yaw_init_window_sec)" type="double"/>
        <param name="traj_server/commanded_yaw_reach_ratio" value="$(arg traj_commanded_yaw_reach_ratio)" type="double"/>
    </node>
    <!-- use simulator -->
    <!-- <include file="$(find ego_planner)/launch/include/simulator.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="init_x_" value="$(arg init_x)"/>
        <arg name="init_y_" value="$(arg init_y)"/>
        <arg name="init_z_" value="$(arg init_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)" />
    </include> -->
    <include file="$(find manual_take_over)/launch/take_over_drone.launch">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="cmd_topic" value="drone_$(arg drone_id)_planning/pos_cmd"/>
    </include>
</launch>
    
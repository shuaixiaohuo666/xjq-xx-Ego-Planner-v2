<!-- 文件路径: planner/plan_manage/launch/include/run_in_sim_replay.xml -->
<launch>
    <!-- 从父启动文件接收的参数 -->
    <arg name="drone_id"/>
    <arg name="map_size_x"/>
    <arg name="map_size_y"/>
    <arg name="map_size_z"/>
    <arg name="init_x"/>
    <arg name="init_y"/>
    <arg name="init_z"/>
    <arg name="flight_type"/>
    <arg name="point_num"/>
    <arg name="odom_topic"/>
	<arg name="max_vel" />
	<arg name="max_acc" />
	<arg name="max_jer" />
	<arg name="planning_horizon" />
	<arg name="thresh_replan_time"/>
	<arg name="local_update_range_x" />
    <arg name="local_update_range_y" />
    <arg name="local_update_range_z" />
  	<arg name="obstacles_inflation" />
	<arg name="virtual_ceil"/>
	<arg name="virtual_ground"/>
    <arg name="target0_x" default="0.0"/>
    <arg name="target0_y" default="0.0"/>
    <arg name="target0_z" default="0.0"/>
    <arg name="target1_x" default="0.0"/>
    <arg name="target1_y" default="0.0"/>
    <arg name="target1_z" default="0.0"/>
    
    <!--
      为回放做的关键修改:
      1. 只启动无人机动力学模拟器(poscmd_2_odom)。
      2. 不启动传感器模拟器(pcl_render_node)。
    -->
    <node pkg="poscmd_2_odom" type="poscmd_2_odom" name="drone_$(arg drone_id)_poscmd_2_odom" output="screen">
        <remap from="~command" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <remap from="~odometry" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        <param name="init_x" value="$(arg init_x)"/>
        <param name="init_y" value="$(arg init_y)"/>
        <param name="init_z" value="$(arg init_z)"/>
    </node>

    <node pkg="odom_visualization" type="odom_visualization" name="drone_$(arg drone_id)_odom_visualization" output="screen">
        <remap from="~odom" to="/drone_$(arg drone_id)_$(arg odom_topic)"/>
        <param name="drone_id" value="$(arg drone_id)"/>
        <param name="robot_scale" value="1.0"/> <!-- 可视化模型的缩放比例 -->
    </node>

    <include file="$(find ego_planner)/launch/include/advanced_param_replay.xml">
        <arg name="drone_id" value="$(arg drone_id)"/>
        <arg name="map_size_x_" value="$(arg map_size_x)"/>
        <arg name="map_size_y_" value="$(arg map_size_y)"/>
        <arg name="map_size_z_" value="$(arg map_size_z)"/>
        <arg name="odometry_topic" value="$(arg odom_topic)"/>
        <arg name="cloud_topic" value="/cloud_registered"/>
        <arg name="max_vel" value="$(arg max_vel)" />
        <arg name="max_acc" value="$(arg max_acc)" />
        <arg name="max_jer" value="$(arg max_jer)" />
        <arg name="planning_horizon" value="$(arg planning_horizon)" />
        <arg name="use_multitopology_trajs" value="false" />
		<arg name="thresh_replan_time" value="$(arg thresh_replan_time)"/>
		<arg name="local_update_range_x" value="$(arg local_update_range_x)" />
    	<arg name="local_update_range_y" value="$(arg local_update_range_y)" />
    	<arg name="local_update_range_z" value="$(arg local_update_range_z)" />
  	 	<arg name="obstacles_inflation" value="$(arg obstacles_inflation)" />
        <arg name="flight_type" value="$(arg flight_type)" />
		<arg name="virtual_ceil" value="$(arg virtual_ceil)"/>
		<arg name="virtual_ground" value="$(arg virtual_ground)"/>
        <arg name="point_num" value="$(arg point_num)" />
        <arg name="point0_x" value="$(arg target0_x)" />
        <arg name="point0_y" value="$(arg target0_y)" />
        <arg name="point0_z" value="$(arg target0_z)" />
        <arg name="point1_x" value="$(arg target1_x)" />
        <arg name="point1_y" value="$(arg target1_y)" />
        <arg name="point1_z" value="$(arg target1_z)" />
    </include>

    <!-- 轨迹服务器 -->
    <node pkg="ego_planner" name="drone_$(arg drone_id)_traj_server" type="traj_server" output="screen">
        <remap from="~planning/trajectory" to="/drone_$(arg drone_id)_planning/trajectory"/>
        <remap from="position_cmd" to="/drone_$(arg drone_id)_planning/pos_cmd"/>
        <param name="traj_server/time_forward" value="1.0" type="double"/>
    </node>
</launch>